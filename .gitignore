# ==========================================
# 1. GLOBAL IGNORES (Folders at any depth)
# ==========================================
# This catches your nested x64/Release and x64/Debug folders
**/[Xx]64/
**/[Rr]elease/
**/[Dd]ebug/
**/.vs/
**/[Bb]in/
**/[Oo]bj/

# ==========================================
# 2. BUILD ARTIFACTS (Extensions)
# ==========================================
*.obj
*.pdb
*.exe
*.ilk
*.tlog
*.recipe
*.lastbuildstate
*.log
*.pch
*.idb

# ==========================================
# 3. ASSET EXCEPTIONS (Keep at bottom)
# ==========================================
# This ensures that .obj files in Assets are saved 
# even though we ignored *.obj above.
!**/Assets/
!**/Assets/**
!**/Assets/**/*.obj
