# ==========================================
# 1. GLOBAL IGNORES (Folders at any depth)
# ==========================================
# This catches your build output folders (trash)
**/[Xx]64/
**/[Rr]elease/
**/[Dd]ebug/
**/.vs/
**/[Bb]in/
**/[Oo]bj/

# ==========================================
# 2. BUILD ARTIFACTS (Extensions)
# ==========================================
*.obj
*.pdb
*.exe
*.ilk
*.tlog
*.recipe
*.lastbuildstate
*.log
*.pch
*.idb

# ==========================================
# 3. ASSET EXCEPTIONS
# ==========================================
# This ensures that .obj files in Assets are saved 
# even though we ignored *.obj above.
!**/Assets/
!**/Assets/**
!**/Assets/**/*.obj

# ==========================================
# 4. LIBRARY EXCEPTIONS (Critical Fix)
# ==========================================
# This forces Git to LOOK INSIDE your "lib" folder,
# even if it contains folders named "x64" or "Release".
!lib/
!lib/**

# Explicitly un-ignore the forbidden folder names inside lib
!**/lib/**/[Xx]64/
!**/lib/**/[Rr]elease/
!**/lib/**/[Dd]ebug/

# ==========================================
# 5. PROJECT FILES (Force Track)
# ==========================================
# Ensure main project files are never ignored
!*.sln
!*.vcxproj
!*.filters
!*.props
